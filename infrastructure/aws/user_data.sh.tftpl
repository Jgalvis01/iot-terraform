#!/bin/bash
set -euxo pipefail
exec > >(tee -a /var/log/warehouse-bootstrap.log) 2>&1

REGION="${region}"
REGISTRY="${ecr_registry}"
APP_DIR=/opt/warehouse

# instalar docker
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL --retry 5 \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

mkdir -p "$APP_DIR"
cat > "$APP_DIR/docker-compose.yml" <<'COMPOSE_EOF'
${compose}
COMPOSE_EOF
chmod 600 "$APP_DIR/docker-compose.yml"

cat > "$APP_DIR/redeploy.sh" <<REDEPLOY_EOF
#!/bin/bash
set -euo pipefail
cd $APP_DIR
for i in \$(seq 1 10); do
  aws ecr get-login-password --region $REGION | docker login --username AWS --password-stdin $REGISTRY && break
  echo "ECR login falló (intento \$i), reintentando..."; sleep 10
done
docker compose pull
docker compose up -d --remove-orphans
docker compose ps
REDEPLOY_EOF
chmod 755 "$APP_DIR/redeploy.sh"

%{ if init_databases ~}
PGIMG=postgres:15-alpine
set +x
export PGPASSWORD='${db_password}'
set -x
psql_rds() {
  docker run --rm -i -e PGPASSWORD "$PGIMG" \
    psql -h "${db_address}" -p "${db_port}" -U "${db_username}" -d postgres -v ON_ERROR_STOP=1 "$@"
}
for i in $(seq 1 60); do
  docker run --rm -e PGPASSWORD "$PGIMG" pg_isready -h "${db_address}" -p "${db_port}" -U "${db_username}" && break
  echo "RDS no disponible aún (intento $i)"; sleep 10
done
for db in ${join(" ", databases)}; do
  if [ "$(psql_rds -tAc "SELECT 1 FROM pg_database WHERE datname='$db'")" != "1" ]; then
    psql_rds -c "CREATE DATABASE $db"
    echo "Base $db creada"
  else
    echo "Base $db ya existe"
  fi
done
unset PGPASSWORD
%{ endif ~}

cd "$APP_DIR"
for i in $(seq 1 10); do
  aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY" && break
  echo "ECR login falló (intento $i)"; sleep 10
done

for i in $(seq 1 30); do
  docker compose pull && break
  echo "docker compose pull falló (intento $i), reintentando en 20 s..."; sleep 20
done
docker compose up -d --remove-orphans || echo "compose up falló: revisar y ejecutar $APP_DIR/redeploy.sh"
docker compose ps || true
echo "Bootstrap terminado"
